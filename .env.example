TZ=Asia/Singapore

# Change this one value when the server moves.
# Use a public DNS name/IP for internet hosting, or a VPN/Tailscale IP for private hosting.
QT_DESK_SERVER_HOST=rustdesk.example.com

# Public addresses clients should use.
RUSTDESK_ID_PUBLIC=${QT_DESK_SERVER_HOST}:21116
RUSTDESK_RELAY_PUBLIC=${QT_DESK_SERVER_HOST}:21117
RUSTDESK_API_PUBLIC_URL=http://${QT_DESK_SERVER_HOST}:21114

# Optional private admin listener.
# Empty = all-in-one local/dev mode, /_admin and /api/admin are served on 21114.
# Set to 0.0.0.0:21124 and use docker-compose.admin-split.yml to keep admin off
# the public 21114 listener. Publish 21124 only to localhost/VPN/reverse-proxy allowlist.
RUSTDESK_API_ADMIN_ADDR=
RUSTDESK_API_ADMIN_HOST_PORT=127.0.0.1:21124

# API container talks back to the host-network server through host-gateway.
RUSTDESK_ID_INTERNAL=host.docker.internal:21116
RUSTDESK_RELAY_INTERNAL=host.docker.internal:21117

# Rotate this if it has ever been pasted into chat, logs, or screenshots.
RUSTDESK_API_JWT_KEY=replace-with-a-long-random-secret

# RustDesk public key shown to clients. Leave empty if /root/data/id_ed25519.pub
# is already present and managed by hbbs.
RUSTDESK_KEY=

RUSTDESK_ENCRYPTED_ONLY=0

SERVER_IMAGE=tanqt0728/rustdesk-selfhost-qt-server:latest
API_IMAGE=tanqt0728/rustdesk-selfhost-qt-api:latest
