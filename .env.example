TZ=Asia/Singapore

# Change this one value when the server moves.
# Use a public DNS name/IP for internet hosting, or a VPN/Tailscale IP for private hosting.
QT_DESK_SERVER_HOST=rustdesk.example.com

# Public addresses clients should use.
RUSTDESK_ID_PUBLIC=${QT_DESK_SERVER_HOST}:21116
RUSTDESK_RELAY_PUBLIC=${QT_DESK_SERVER_HOST}:21117
RUSTDESK_API_PUBLIC_URL=http://${QT_DESK_SERVER_HOST}:21114

# Optional private admin listener.
# Empty = all-in-one local/dev mode, /_admin and /api/admin are served on 21114.
# Set to 0.0.0.0:21124 and use docker-compose.admin-split.yml to keep admin off
# the public 21114 listener. Publish 21124 only to localhost/VPN/reverse-proxy allowlist.
RUSTDESK_API_ADMIN_ADDR=
RUSTDESK_API_ADMIN_HOST_PORT=127.0.0.1:21124

# Values shown to RustDesk clients and Web v3. Use a public DNS name/IP or
# a VPN/Tailscale IP that browsers and clients can reach.

# Rotate this if it has ever been pasted into chat, logs, or screenshots.
RUSTDESK_API_JWT_KEY=replace-with-a-long-random-secret

# RustDesk public key is read from /server-data/id_ed25519.pub.
# Change it from Admin Settings by importing a matching public/private keypair.

# 1 = hbbs/hbbr require the server key (-k): nobody can use this server as a free relay.
# Every client must have the server public key configured.
RUSTDESK_ENCRYPTED_ONLY=1
RUSTDESK_MUST_LOGIN=Y

# Login lifetime. Stock RustDesk clients cannot refresh their JWT, so the JWT
# cap must be long or clients are logged out when it passes. The DB session
# (TOKEN_EXPIRE) slides on every authenticated call and can be revoked in admin.
# These env values override admin-page edits on every container restart.
RUSTDESK_API_APP_TOKEN_EXPIRE=2160h
RUSTDESK_API_JWT_EXPIRE_DURATION=8760h

# Failed logins per IP in 10 minutes before a 30-minute ban (0 disables).
RUSTDESK_API_APP_BAN_THRESHOLD=10
# Reverse proxy address(es) to trust for X-Forwarded-For; empty = trust none.
RUSTDESK_API_GIN_TRUST_PROXY=

SERVER_IMAGE=tanqt11/rustdesk-selfhost-qt-server:latest
API_IMAGE=tanqt11/rustdesk-selfhost-qt-api:latest
